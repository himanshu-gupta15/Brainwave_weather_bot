# Copy to .env.local (git-ignored) and fill in. Without an API key the app runs
# in deterministic mode: keyword intent extraction + template replies.

# LLM used ONLY for (1) classifying the question into a fixed schema and
# (2) wording the reply from verified facts. It never chooses the advice.
LLM_PROVIDER=openai            # openai | anthropic | none
LLM_MODEL=gpt-4o-mini          # e.g. gpt-4o-mini, or claude-sonnet-5-5 for anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# SOPS_PATH=./data/sops.yaml
# TAXONOMY_PATH=./data/taxonomy.yaml
# HTTP_TIMEOUT_MS=10000
